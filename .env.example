# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication and encryption
AUTH_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-key
AUDIT_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Durable infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/zerionx1
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=zerion-x1-development

# Observability
OBSERVABILITY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Execution remains disabled until sandbox and approval gates pass
EXECUTION_LIVE_ENABLED=false
EXECUTION_WORKER_URL=

# Real market data gateway. It must expose GET /quote and GET /candles.
# Crypto BTC/USDT and ETH/USDT can use the built-in public Binance fallback.
ZERION_MARKET_DATA_BASE_URL=
ZERION_MARKET_DATA_API_KEY=

# Broker OAuth authorization endpoints (provider developer apps required)
BROKER_ZERODHA_OAUTH_URL=
BROKER_UPSTOX_OAUTH_URL=
BROKER_ANGEL_ONE_OAUTH_URL=
BROKER_FYERS_OAUTH_URL=
BROKER_SHOONYA_OAUTH_URL=
