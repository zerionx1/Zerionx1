{
  "name": "zerion-x1",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run test && npm run build",
    "verify:production": "node scripts/verify-production.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "quality": "npm run lint && npm run typecheck && npm test && npm run check:secrets",
    "release:check": "npm run verify:phase7 && npm run verify:phase8 && npm run verify:phase9 && npm run verify:phase10 && npm run quality && npm run build && npm run verify:production",
    "verify:phase7": "node scripts/verify-phase-7.mjs",
    "verify:phase8": "node scripts/verify-phase-8.mjs",
    "verify:phase9": "node scripts/verify-phase-9.mjs",
    "verify:phase10": "node scripts/verify-phase-10.mjs",
    "check:migrations": "node scripts/check-migration-order.mjs",
    "check:routes": "node scripts/check-route-security.mjs",
    "phase10:verify": "npm run verify:phase10 && npm run check:migrations && npm run check:routes",
    "start:realtime": "tsx src/workers/realtime-worker.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/react-query": "^5.84.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.0.12",
    "lucide-react": "^0.468.0",
    "next": "15.5.22",
    "protobufjs": "^8.7.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.12",
    "ws": "^8.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.22",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22 <25"
